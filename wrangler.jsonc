{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // 워커 이름은 **기존과 동일**하게 유지해야 같은 워커에 배포된다 (도메인·Secrets 승계).
    "name": "tailored-ad",
    "compatibility_date": "2026-09-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./worker/index.ts",
    "upload_source_maps": true,
    // 비밀이 아닌 값만 여기에 둔다 (git 추적됨).
    // ⚠️ 이 블록을 빠뜨리고 배포하면 **대시보드의 plain 변수가 지워진다** (구 프로젝트에서 실제 발생).
    //    값을 바꾸면 반드시 이 파일에도 반영할 것.
    "vars": {
        "BASE_URL": "https://tailoredad.com",
        // dev/prod 구분자 — Dodo 환경(live_mode/test_mode) 선택 등에 쓴다.
        // 로컬에서는 .dev.vars가 "development"로 덮어쓴다.
        "ENVIRONMENT": "production"
    },
    // 비밀값 **이름만** 선언한다 (값 아님). `wrangler types`가 이 목록으로 타입을 만든다.
    // ⚠️ 선언하면 `.dev.vars`에서 **여기 있는 키만** 로컬 env로 들어간다.
    //    키를 추가할 때 : ①여기 ②대시보드 Secret ③`.dev.vars`(로컬) 세 곳.
    "secrets": {
        "required": [
            "NEON_DATABASE_URL",
            "NEON_AUTH_BASE_URL",
            "NEON_AUTH_COOKIE_SECRET",
            "DODO_PAYMENTS_API_KEY",
            "DODO_PAYMENTS_WEBHOOK_KEY",
            // 웹훅 URL 서명 키로 재사용 (self-fetch 폐기로 원래 용도가 사라짐)
            "INTERNAL_FIRE_AND_FORGET_API_SECRET",
            "OPENROUTER_API_KEY",
            "REPLICATE_API_TOKEN",
            "CLOUDFLARE_R2_ACCESS_KEY_ID",
            "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
            "CLOUDFLARE_R2_BUCKET",
            "CLOUDFLARE_R2_ENDPOINT",
            "UPSTASH_REDIS_REST_URL",
            "UPSTASH_REDIS_REST_TOKEN"
        ]
    },
    "assets": {
        // 자산 바인딩 — 페이지 가드가 통과시킬 때 `env.ASSETS.fetch()`로 넘긴다
        "binding": "ASSETS",
        // SPA 라우팅: 없는 경로는 index.html
        "not_found_handling": "single-page-application",
        // /api/* 는 항상 워커로 (웹훅도 /api/webhook/* 로 옮겨 이 규칙 하나로 커버한다)
        // 보호 화면은 주소창 요청(navigate)이 자산으로 새지 않도록 명시한다 — worker/routes/pages.ts
        "run_worker_first": [
            "/api/*",
            "/sign-in",
            "/create",
            "/create/*",
            "/projects",
            "/projects/*",
            "/profile",
            "/profile/*",
            "/checkout/success"
        ]
    },
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1
        }
    },
    // 파이프라인 오케스트레이터 — 클래스는 worker/index.ts가 export 한다.
    // binding 이름은 코드에서 `env.BATCH_PIPELINE` 으로 접근한다.
    "workflows": [
        {
            "binding": "BATCH_PIPELINE",
            "name": "batch-pipeline",
            "class_name": "BatchPipeline"
        }
    ]
}
