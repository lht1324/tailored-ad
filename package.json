{
    "name": "tailored-ad",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "deploy": "npm run build && wrangler deploy",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
        "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "hono": "^4.13.14",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@cloudflare/workers-types": "^5.20261031.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "wrangler": "^4.156.0"
    }
}
