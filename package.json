{
    "name": "tailored-ad",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "deploy": "npm run build && wrangler deploy",
        "typecheck": "npm run cf-typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
        "cf-typegen": "wrangler types --include-runtime false --no-strict-vars --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/s3-request-presigner": "^3.1161.0",
        "@neondatabase/auth": "^0.7.0-beta",
        "@neondatabase/serverless": "^1.2.0",
        "@upstash/ratelimit": "^2.2.0",
        "@upstash/redis": "^1.40.0",
        "dodopayments": "^2.59.0",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.14",
        "jsonrepair": "^3.15.0",
        "lucide-react": "^1.66.0",
        "openai": "^7.47.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "replicate": "^1.4.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "wrangler": "^4.156.0"
    }
}
