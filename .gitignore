# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-docker/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
.open-next/
.wrangler/
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# Agents
.agents/*
# 프로젝트 문서는 추적 (설치형 스킬·락파일은 PC별로 각자 설치)
!.agents/product-marketing.md
skills-lock.json

# one-off seed scripts (may reference live env files)
scripts/

# 시딩 아웃리치 산출물 — 타사 브랜드 자산 · git 미추적 · public 금지
seed-outreach/


# local-only opencode MCP config (holds real API keys — never commit)
opencode.json
