{
    // 클라·워커 두 타입 프로그램이 **공유하는 설정**. 여기가 유일한 원본이다.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,

        // ⚠️ `paths`는 **baseUrl 기준**으로 해석된다. baseUrl은 이 파일 위치(=루트)를 가리킨다.
        //    왜 baseUrl을 두나: `paths`만 있으면 IDE가 "어느 설정 기준으로 읽을지"를 제각각
        //    해석한다(WebStorm이 하위 tsconfig 기준으로 계산해 깨졌다). baseUrl+paths는
        //    모든 에디터가 오래전부터 동일하게 처리하는 형태다.
        //
        // ⚠️ 이 값들은 vite.config.ts의 resolve.alias와 같아야 한다 (Vite는 tsconfig를 안 읽는다).
        //
        // 첫 글자가 진영을 말한다:
        //   @/       클라(src) — 브라우저에서만
        //   @worker/ 서버(worker) — 워커에서만
        //   @shared/ 양쪽 공용 — 부수효과 없는 타입·상수·순수 함수만
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@client/*": ["lib/client/*"],
            "@server/*": ["lib/server/*"],
            "@shared/*": ["lib/shared/*"]
        }
    }
}
