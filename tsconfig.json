{
    // 클라(브라우저) 타입 프로그램 — React + Vite.
    // 이 파일이 **루트 기본 설정**이다. `worker/`는 여기 포함되지 않고,
    // `worker/tsconfig.json`(별도 파일)이 그쪽을 맡는다.
    // → 에디터는 "가장 가까운 tsconfig"로 파일을 배정하므로 두 진영이 섞이지 않는다.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": ["src", "shared", "vite.config.ts"]
}
