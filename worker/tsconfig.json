{
    // 이 파일은 **에디터용**이다 (CLI 타입체크는 루트의 `tsconfig.worker.json`을 쓴다).
    //
    // 왜 필요한가: 이게 없으면 `worker/**` 파일이 어느 tsconfig에도 속하지 않아
    // 에디터가 "프로젝트 밖 파일"로 처리하고, `paths`(@worker·@shared)를 적용하지 않는다.
    // VS Code의 프로젝트 참조(references)로도 해결되지 않았다 — WebStorm이 따라가지 않는다.
    // 가장 가까운 tsconfig를 두면 두 에디터 모두 확실히 인식한다.
    //
    // `include`는 부모(tsconfig.worker.json)에 있는 값을 그대로 상속한다.
    // 상속된 패턴은 **부모 파일 위치 기준**으로 해석되므로 루트 기준 경로가 유지된다.
    "extends": "../tsconfig.worker.json"
}
